# Public (EIA) inference service. Architecture.md Section 7: the EIA artifact is federal
# public-domain input with nothing to protect, so it bakes into the image and ships via
# public GHCR -- unlike the PJM image, which never bakes in its artifact.
FROM python:3.12-slim AS base

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY pyproject.toml ./
COPY common ./common
COPY model ./model
COPY inference ./inference

RUN pip install --no-cache-dir .

# Baked in deliberately -- train this locally first (scripts/train_detector_eia.py) and
# make sure it exists before building this image.
COPY artifacts/eia_detector.joblib ./artifacts/eia_detector.joblib

EXPOSE 8000
ENTRYPOINT ["uvicorn", "inference.eia_service:app", "--host", "0.0.0.0", "--port", "8000"]
