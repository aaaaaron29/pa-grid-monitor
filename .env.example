# Copy to .env for local dev. Never commit the real file (.env is gitignored).

# --- Public tier (EIA) ---
EIA_API_KEY=                          # https://www.eia.gov/opendata/register.php
EIA_POLL_INTERVAL_SECONDS=3600        # EIA-930 is hourly; polling faster re-reads the same rows
EIA_ROLLING_WINDOW_HOURS=72           # re-pulled every cycle to absorb EIA's post-publication revisions
EIA_BACKFILL_PAGE_SIZE=5000           # API v2 hard cap per request

# --- Private tier (PJM) --- (Phase 1 scope: public/EIA only; these are read but unused until the PJM poller ships)
PJM_API_KEY=
PJM_POLL_INTERVAL_SECONDS=300         # matches PJM's 5-minute refresh

# --- Storage ---
POSTGRES_DSN=postgresql://pjm_grid_watch:pjm_grid_watch@localhost:5432/pjm_grid_watch

# --- App ---
ENVIRONMENT=development               # development | production
LOG_LEVEL=INFO
METRICS_PORT=9100                     # Prometheus scrapes /metrics here
