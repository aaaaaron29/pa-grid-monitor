# Postgres connection used by lib/db.ts (postgres.js). Point this at Neon's POOLED
# connection string in production (the "-pooler" host) -- see ARCHITECTURE.md Section 9
# item 7. Neon requires SSL; add ?sslmode=require if it's not already in the string Neon
# gives you.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared passcode gating everything under /private/*. Set a real value in Vercel for both
# the Production and Preview environments -- middleware.ts fails closed (denies access) if
# this is unset, so an unset var means /private/* is unreachable, not open.
PRIVATE_PASSCODE=
