# Private (PJM) inference service. Architecture.md Section 7: a PJM-trained artifact is
# PJM-derived material and must never be committed or baked into a public image -- it is
# mounted at runtime instead (a PVC on the VM, a bind mount locally). This image deliberately
# does NOT COPY anything from artifacts/; docker-compose.yml mounts that directory in.
FROM python:3.12-slim AS base

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY pyproject.toml ./
COPY common ./common
COPY model ./model
COPY inference ./inference

RUN pip install --no-cache-dir .

EXPOSE 8000
ENTRYPOINT ["uvicorn", "inference.pjm_service:app", "--host", "0.0.0.0", "--port", "8000"]
