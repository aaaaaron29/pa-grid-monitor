# Copy to deploy/vps/.env on the server and fill in. Never commit the real file.

# --- Database (local to the server; nothing is published to the internet) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Data sources ---
EIA_API_KEY=
PJM_API_KEY=

# --- Website database (Neon). Use the DIRECT (unpooled) URL; the hourly sync writes here. ---
NEON_DIRECT_URL=

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Alerts (both optional; with neither, problems are only written to the log) ---
# Phone push through ntfy.sh. Pick a long random topic name: anyone who knows it can read it.
NTFY_TOPIC=
# Dead-man's switch: a URL such as https://hc-ping.com/<uuid> from healthchecks.io, pinged after
# every clean check. If the server dies, the pings stop and that service emails you.
HEARTBEAT_URL=
